# Server configuration
PORT=
NODE_ENV=

# Database configuration
MONGODB_URI=
# Required. Local development must use kikhobor_dev (never production kikhobor).
# Production deployments should set this to kikhobor.
MONGODB_DB_NAME=kikhobor_dev
# Mandatory for scripts/copy-prod-to-dev.ts (no fallback to MONGODB_URI).
# MONGODB_URI_READONLY must be a read-only production credential.
# MONGODB_URI_DEV must be restricted to kikhobor_dev writes.
MONGODB_URI_READONLY=
MONGODB_URI_DEV=

# AI Assistant configuration
GEMINI_API_KEY=

# Shared AI rate limiting (Upstash Redis REST)
# Required for /api/ask and /api/assistant in production.
# Also required for admin login rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin authentication (server-side only — never expose to the client)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
# Optional session lifetime (default 8h). Examples: 8h, 480m, 28800
ADMIN_SESSION_TTL=
# Preferred absolute origin for CSRF checks (required in production), e.g. https://example.com
APP_ORIGIN=
